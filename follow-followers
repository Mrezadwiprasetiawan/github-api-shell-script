#!/bin/bash
# follow-followers: Follow back everyone who follows USERNAME.
# Usage: ./follow-followers TOKEN USERNAME

set -uo pipefail

if (( $# < 2 )); then
  echo "Usage: $(basename "$0") TOKEN USERNAME"
  exit 1
fi

TOKEN=$1
USERNAME=$2
PER_PAGE=100
PAGE=1

BASE_HEADER="Authorization: token $TOKEN"
API="https://api.github.com"

# --------------------------------------------------------------------------- #
# wait_for_rate_limit_reset
# --------------------------------------------------------------------------- #
wait_for_rate_limit_reset() {
  echo "Rate limit reached – waiting for reset…"
  while true; do
    local rl remaining reset_time now wait_sec
    rl=$(curl -s -H "$BASE_HEADER" "$API/rate_limit" 2>/dev/null) || rl="{}"
    remaining=$(echo "$rl" | jq -r '.resources.core.remaining // 0')
    reset_time=$(echo "$rl" | jq -r '.resources.core.reset // 0')
    if (( remaining > 0 )); then
      echo "Rate limit available again: $remaining requests remaining."
      return
    fi
    now=$(date +%s)
    wait_sec=$(( reset_time - now ))
    (( wait_sec < 1 )) && wait_sec=5
    echo "Waiting ${wait_sec}s…"
    sleep "$wait_sec"
  done
}

# --------------------------------------------------------------------------- #
# handle_403 <response_body>
#   Baca pesan dari body 403 dan putuskan tindakan:
#     - secondary rate limit  → tunggu 60s lalu return 0 (retry)
#     - rate limit exceeded   → wait_for_rate_limit_reset, return 0 (retry)
#     - follow limit / policy → cetak pesan, return 1 (skip user ini)
# --------------------------------------------------------------------------- #
handle_403() {
  local body="$1"
  local msg
  msg=$(echo "$body" | jq -r '.message // empty' 2>/dev/null)

  case "$msg" in
    *"secondary rate limit"*|*"abuse"*)
      echo "Secondary rate limit – tunggu 60s…"
      sleep 60
      return 0   # boleh retry
      ;;
    *"rate limit exceeded"*|*"API rate limit"*)
      wait_for_rate_limit_reset
      return 0   # boleh retry
      ;;
    *)
      # Follow limit GitHub (~400 user) atau kebijakan lain – tidak perlu retry
      echo "SKIP (403: ${msg:-unknown policy})"
      return 1   # skip user ini
      ;;
  esac
}

# --------------------------------------------------------------------------- #
# follow_user <login>
#   Coba follow, tangani 403 dengan benar.
# --------------------------------------------------------------------------- #
follow_user() {
  local user="$1"
  local tmpfile body http_code

  printf "Following: %-40s " "$user"

  while true; do
    tmpfile=$(mktemp)
    http_code=$(curl -s -w "%{http_code}" -o "$tmpfile" \
      -X PUT \
      -H "$BASE_HEADER" \
      -H "Content-Length: 0" \
      "$API/user/following/$user")
    body=$(cat "$tmpfile"); rm -f "$tmpfile"

    case "$http_code" in
      204)
        echo "OK"
        return
        ;;
      304)
        echo "already following"
        return
        ;;
      403)
        # Baca body dulu sebelum memutuskan
        if handle_403 "$body"; then
          # retry
          printf "Following: %-40s " "$user"
        else
          return   # skip
        fi
        ;;
      429)
        echo "429 Too Many Requests – tunggu 60s…"
        sleep 60
        printf "Following: %-40s " "$user"
        ;;
      *)
        echo "HTTP $http_code"
        return
        ;;
    esac
  done
}

# --------------------------------------------------------------------------- #
# Main
# --------------------------------------------------------------------------- #
echo "Following back all followers of '$USERNAME'…"

while true; do
  local_tmpfile=$(mktemp)
  response=$(curl -sD "$local_tmpfile" \
    -H "$BASE_HEADER" \
    "$API/users/$USERNAME/followers?per_page=$PER_PAGE&page=$PAGE")
  link_header=$(grep -i '^link:' "$local_tmpfile" || true)
  rm -f "$local_tmpfile"

  local_msg=$(echo "$response" | jq -r '.message // empty' 2>/dev/null)
  if [[ "$local_msg" == *"rate limit"* ]]; then
    wait_for_rate_limit_reset
    continue
  fi

  mapfile -t followers < <(echo "$response" | jq -r '.[].login' 2>/dev/null)
  if (( ${#followers[@]} == 0 )); then
    echo "Tidak ada follower lagi."
    break
  fi

  for follower in "${followers[@]}"; do
    follow_user "$follower"
  done

  if [[ "$link_header" == *'rel="next"'* ]]; then
    (( PAGE++ ))
  else
    break
  fi
done

echo "Selesai."
