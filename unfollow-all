#!/usr/bin/env bash
# unfollow-all: Unfollow every user listed in a file.
# Usage: ./unfollow-all GITHUB_TOKEN [USERNAME_FILE]

set -uo pipefail

if [[ -z "${1:-}" ]]; then
  echo "Usage: $(basename "$0") GITHUB_TOKEN [USERNAME_FILE]"
  exit 1
fi

TOKEN="$1"
FILE="${2:-followed_users.txt}"

if [[ ! -f "$FILE" ]]; then
  echo "Error: file '$FILE' not found." >&2
  exit 1
fi

BASE_HEADER="Authorization: Bearer $TOKEN"
API="https://api.github.com"

# --------------------------------------------------------------------------- #
# wait_for_rate_limit_reset
# --------------------------------------------------------------------------- #
wait_for_rate_limit_reset() {
  echo "Rate limit reached – waiting for reset…"
  while true; do
    local rl rem rst now wait_sec
    rl=$(curl -sf -H "$BASE_HEADER" "$API/rate_limit" 2>/dev/null) || rl="{}"
    rem=$(echo "$rl" | jq -r '.resources.core.remaining // 0')
    rst=$(echo "$rl" | jq -r '.resources.core.reset // 0')
    (( rem > 0 )) && return
    now=$(date +%s)
    wait_sec=$(( rst - now ))
    (( wait_sec < 1 )) && wait_sec=5
    echo "  sleeping ${wait_sec}s…"
    sleep "$wait_sec"
  done
}

total=0
unfollowed=0

while IFS= read -r username; do
  [[ -z "$username" ]] && continue
  (( ++total ))
  printf "Unfollowing %-40s " "$username"

  http_code=$(curl -s -o /dev/null -w "%{http_code}" \
    -X DELETE \
    -H "$BASE_HEADER" \
    "$API/user/following/$username")

  case "$http_code" in
    204)
      echo "OK"
      (( ++unfollowed )) || true
      ;;
    404)
      echo "not found / not following"
      ;;
    403|429)
      echo "rate limited – waiting…"
      wait_for_rate_limit_reset
      # Retry once
      http_code2=$(curl -s -o /dev/null -w "%{http_code}" \
        -X DELETE \
        -H "$BASE_HEADER" \
        "$API/user/following/$username")
      [[ "$http_code2" == "204" ]] && { echo "  OK (retry)"; (( ++unfollowed )) || true; } \
                                   || echo "  failed (HTTP $http_code2)"
      ;;
    *)
      echo "HTTP $http_code"
      ;;
  esac
done < "$FILE"

echo "Done. Unfollowed $unfollowed / $total users from '$FILE'."
