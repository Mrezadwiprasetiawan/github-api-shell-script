#!/bin/bash

if (( $# < 1 )); then
  echo "Usage: $(basename "$0") GITHUB_TOKEN [--reset] [--file FILE_NAME] [--min-followers N] [--max-followers N]"
  exit 1
fi

GITHUB_TOKEN=$1
shift

RESET=0
FOLLOWED_FILE="followed_users.txt"
MIN_FOLLOWERS=1000
MAX_FOLLOWERS=
PER_PAGE=100

# Parse options
while (( $# )); do
  case "$1" in
    --reset)
      RESET=1
      shift
      ;;
    --file)
      shift
      FOLLOWED_FILE="$1"
      shift
      ;;
    --min-followers)
      shift
      MIN_FOLLOWERS="$1"
      shift
      ;;
    --max-followers)
      shift
      MAX_FOLLOWERS="$1"
      shift
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if (( RESET )); then
  rm -f "$FOLLOWED_FILE"
fi
touch "$FOLLOWED_FILE"

# Load followed users into an associative array for fast lookup
declare -A followed
while read -r user; do
  [[ -n "$user" ]] && followed["$user"]=1
done < "$FOLLOWED_FILE"

tput civis
trap 'tput cnorm; exit' INT TERM EXIT

wait_for_rate_limit_reset() {
  echo -e "\nRate limit exceeded; waiting for reset…"
  while :; do
    rl=$(curl -s -H "Authorization: token $GITHUB_TOKEN" https://api.github.com/rate_limit)
    rem=$(echo "$rl" | jq -r '.resources.core.remaining // 0')
    rst=$(echo "$rl" | jq -r '.resources.core.reset // 0')
    (( rem > 0 )) && break
    now=$(date +%s)
    sleep $(( rst > now ? rst - now : 1 ))
  done
}

get_top_users() {
  local page=$1
  local q="followers:>=$MIN_FOLLOWERS"
  if [[ -n "$MAX_FOLLOWERS" ]]; then
    q="followers:$MIN_FOLLOWERS..$MAX_FOLLOWERS"
  fi
  curl -s -H "Authorization: token $GITHUB_TOKEN" \
    "https://api.github.com/search/users?q=$q&sort=followers&order=desc&per_page=$PER_PAGE&page=$page"
}

count=0
page=1

while :; do
  # Rate limit check before batch
  rl=$(curl -s -H "Authorization: token $GITHUB_TOKEN" https://api.github.com/rate_limit)
  rem=$(echo "$rl" | jq -r '.resources.core.remaining // 0')
  (( rem <= 1 )) && wait_for_rate_limit_reset

  users_json=$(get_top_users $page)
  user_logins=$(echo "$users_json" | jq -r '.items[]?.login')
  [[ -z "$user_logins" ]] && break

  for u in $user_logins; do
    printf "\r%-60s" "$u: checking…"
    # Skip if already followed in our set
    if [[ ${followed["$u"]+_} ]]; then
      continue
    fi

    # Get follower count for this user (optional: verify again)
    followers=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
      "https://api.github.com/users/$u" | jq .followers)
    if (( followers < MIN_FOLLOWERS )); then
      continue
    fi
    if [[ -n "$MAX_FOLLOWERS" && $followers -gt $MAX_FOLLOWERS ]]; then
      continue
    fi

    # Try to follow (idempotent)
    code=$(curl -s -o /dev/null -w "%{http_code}" -X PUT \
      -H "Authorization: token $GITHUB_TOKEN" \
      https://api.github.com/user/following/"$u")

    if (( code == 204 )); then
      echo "$u" >> "$FOLLOWED_FILE"
      followed["$u"]=1
      (( count++ ))
      printf "\r%-60s\n" "$u: followed ($followers followers)"
    elif (( code == 403 )); then
      wait_for_rate_limit_reset
      code2=$(curl -s -o /dev/null -w "%{http_code}" -X PUT \
        -H "Authorization: token $GITHUB_TOKEN" \
        https://api.github.com/user/following/"$u")
      if (( code2 == 204 )); then
        echo "$u" >> "$FOLLOWED_FILE"
        followed["$u"]=1
        (( count++ ))
      fi
    fi
  done

  # Next page
  ((page++))
done

tput cnorm
echo -e "\nDone. Total followed: $count"
