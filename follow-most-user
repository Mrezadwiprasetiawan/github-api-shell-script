#!/bin/bash

if (( $# < 2)); then
  echo $(basename $0)" GITHUB_TOKEN COUNTRY"
  exit
fi
# Token GitHub dan negara
GITHUB_TOKEN=$1
COUNTRY=$2
PER_PAGE=100  # Jumlah hasil per halaman

echo "Mencari pengguna paling aktif di GitHub berdasarkan negara: $COUNTRY"

# Fungsi untuk menunggu hingga rate limit direset
wait_for_rate_limit_reset() {
  echo "Mencapai batas API, menunggu hingga rate limit direset..."
  while :; do
    rate_limit=$(curl -s -H "Authorization: token $GITHUB_TOKEN" https://api.github.com/rate_limit)
    remaining=$(echo "$rate_limit" | jq .rate.remaining)
    reset_time=$(echo "$rate_limit" | jq .rate.reset)
    if [[ $remaining -gt 0 ]]; then
      echo "Rate limit tersedia kembali: $remaining permintaan tersisa."
      break
    fi
    current_time=$(date +%s)
    wait_time=$((reset_time - current_time))
    echo "Menunggu $wait_time detik hingga rate limit direset..."
    sleep $wait_time
  done
}

# Fungsi untuk mengambil data pengguna
get_users() {
  local page=$1
  echo "Mengambil halaman $page..."
  response=$(curl -s -w "%{http_code}" -H "Authorization: token $GITHUB_TOKEN" \
    "https://api.github.com/search/users?q=location:$COUNTRY&per_page=$PER_PAGE&page=$page")
  http_code=$(echo "$response" | tail -n1)  # Ambil kode status HTTP
  body=$(echo "$response" | sed '$d')  # Ambil JSON body (tanpa kode status HTTP)
  # Cek kode status HTTP
  if [[ "$http_code" -ne 200 ]]; then
    echo "Kesalahan: API mengembalikan status $http_code"
    echo "$body"  # Cetak body untuk informasi lebih lanjut
    exit 1
  fi
  # Tampilkan respons JSON untuk memastikan data yang diterima
  echo "Respons JSON dari API:"
  echo "$body" | jq .
  echo "$body"
}

# Loop untuk semua halaman
page=1
while :; do
  get_users $page
  # Validasi apakah respons adalah JSON valid
  if ! echo "$response" | jq . > /dev/null 2>&1; then
    echo "Kesalahan: Respons dari API bukan JSON yang valid."
    exit 1
  fi
  # Mengecek apakah ada hasil di halaman ini
  users=$(echo "$response" | jq -c '.items[] | {login: .login}')
  if [[ -z "$users" ]]; then
    echo "Tidak ada pengguna lagi di halaman $page. Proses selesai."
    break
  fi
  echo "Memproses pengguna di halaman $page:"
  # Loop untuk setiap pengguna di halaman ini
  echo "$users" | while read user; do
    username=$(echo "$user" | jq -r .login)
    echo "Memproses pengguna: $username"
    # Cek apakah pengguna sudah diikuti
    check_follow=$(curl -s -o /dev/null -w "%{http_code}" \
      -H "Authorization: token $GITHUB_TOKEN" \
      "https://api.github.com/user/following/$username")
    if [[ $check_follow -eq 204 ]]; then
      echo "Anda sudah mengikuti: $username"
      continue
    fi
    # Auto-follow pengguna yang belum diikuti
    follow_response=$(curl -s -o /dev/null -w "%{http_code}" -X PUT \
      -H "Authorization: token $GITHUB_TOKEN" \
      "https://api.github.com/user/following/$username")
    # Cek status respons follow
    if [[ $follow_response -eq 204 ]]; then
      echo "Berhasil mengikuti: $username"
    else
      echo "Gagal mengikuti: $username (Status: $follow_response)"
    fi
  done
  # Cek rate limit
  rate_limit=$(curl -s -H "Authorization: token $GITHUB_TOKEN" https://api.github.com/rate_limit)
  remaining=$(echo "$rate_limit" | jq .rate.remaining)
  if [[ $remaining -le 0 ]]; then
    wait_for_rate_limit_reset
  else
    echo "Masih ada $remaining permintaan tersisa. Melanjutkan..."
  fi
  # Lanjutkan ke halaman berikutnya
  page=$((page + 1))
done
