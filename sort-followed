#!/bin/bash

if (( $# < 1 )); then
  echo "Usage: $(basename "$0") GITHUB_TOKEN [--file FOLLOWED_FILE]"
  exit 1
fi

GITHUB_TOKEN=$1
shift

FOLLOWED_FILE="followed_users.txt"

while (( $# )); do
  case "$1" in
    --file)
      shift
      FOLLOWED_FILE="$1"
      shift
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [[ ! -f "$FOLLOWED_FILE" ]]; then
  echo "File $FOLLOWED_FILE not found."
  exit 1
fi

TMP_SORT=$(mktemp)
user_count=$(grep -cve '^\s*$' "$FOLLOWED_FILE")
done_count=0

progress_bar() {
  local progress=$1
  local total=$2
  local width=40
  local percent=$(( 100 * progress / total ))
  local filled=$(( width * progress / total ))
  local empty=$(( width - filled ))
  printf "\r["
  for ((i=0; i<filled; i++)); do printf "#"; done
  for ((i=0; i<empty; i++)); do printf " "; done
  printf "] %3d%% (%d/%d)" "$percent" "$progress" "$total"
}

while read -r user; do
  [[ -z "$user" ]] && continue
  ((done_count++))
  progress_bar "$done_count" "$user_count"
  printf "  |  %s" "$user"
  followers=$(curl -s -H "Authorization: token $GITHUB_TOKEN" "https://api.github.com/users/$user" | jq -r '.followers // 0')
  echo -e "$followers\t$user"
done < "$FOLLOWED_FILE" | sort -n > "$TMP_SORT"

cut -f2 "$TMP_SORT" > "$FOLLOWED_FILE"
rm "$TMP_SORT"

progress_bar "$user_count" "$user_count"
printf "\nSelesai! File %s sudah diurutkan dari followers terkecil ke terbesar.\n" "$FOLLOWED_FILE"
